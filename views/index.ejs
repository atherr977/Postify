<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="stylesheet" href="/style.css" />
    <title>All Posts</title>
</head>
<body>
  <h1 class="logo">
    Post<span>ify</span>
</h1>
    <% for(post of posts) { %>
        <div class="post">
            <h3 class="user">@<%= post.username %></h3>
            <h5 class="content"><%= post.content %></h5>
            <br>
            <a href="/posts/<%= post.id %>">See in Detail</a>
           <a href="/posts/<%= post.id %>/edit">Edit</a>
            <form method="post" action="/posts/<%=post.id%>?_method=DELETE">
    <button>Delete</button>
</form> 
        </div>
    <% } %>
    <br />
    <br />
   <a href="/posts/new">Create New Post</a>
<button onclick="resetDemo()">Reset Demo Data</button>
    <footer class="footer">
    Crafted by <strong>Athar Ashraf</strong>
</footer>
<script>
async function resetDemo() {
    const key = prompt("Enter reset key:");

    if (!key) return;

    const response = await fetch("/reset-demo", {
        method: "POST",
        headers: {
            "Content-Type": "application/json"
        },
        body: JSON.stringify({ key })
    });

    if (response.ok) {
        alert("Demo data restored!");
        location.reload();
    } else {
        alert("Invalid reset key!");
    }
}
</script>
</body>
</html>
